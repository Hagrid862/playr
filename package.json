{
  "name": "playr",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "docker compose -f docker-compose.dev.yml up -d && turbo run dev",
    "dev:host": "turbo run dev:host",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test:unit test:integration test:e2e",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "test:coverage": "turbo run test:coverage",
    "prisma:generate": "turbo run prisma:generate",
    "prisma:migrate": "turbo run prisma:migrate",
    "prisma:push": "turbo run prisma:push",
    "prisma:studio": "turbo run prisma:studio"
  },
  "devDependencies": {
    "license-checker": "^25.0.1",
    "madge": "^8.0.0",
    "prettier": "catalog:",
    "prettier-plugin-packagejson": "^3.0.0",
    "turbo": "^2.7.6",
    "typescript": "catalog:",
    "lodash": "^4.17.21"
  },
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24"
  },
  "pnpm": {
    "overrides": {
      "@isaacs/brace-expansion": "^5.0.1",
      "fast-xml-parser": "^5.5.6",
      "fast-xml-builder": "^1.1.7",
      "fast-uri": "^3.1.2",
      "minimatch": "^10.2.3",
      "multer": "^2.1.1",
      "picomatch@2": "2.3.2",
      "picomatch@4": "4.0.4",
      "hono": "^4.12.4",
      "@hono/node-server": "^1.19.10",
      "rollup": "^4.59.0",
      "serialize-javascript": "^7.0.3",
      "flatted": "^3.4.2",
      "effect": "^3.20.0",
      "liquidjs": ">=10.25.7"
    },
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/engines",
      "@scarf/scarf",
      "@swc/core",
      "argon2",
      "esbuild",
      "msgpackr-extract",
      "prisma",
      "sharp"
    ]
  }
}