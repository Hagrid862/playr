{
  "extends": "@repo/configs/typescript/nestjs.json",

  "compilerOptions": {
    "types": ["node", "vitest/globals", "multer"],
    "allowJs": true,
    "checkJs": false,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*", "integration/**/*", "tsup.config.ts", "src/types/tsup.d.ts"],
  "exclude": ["node_modules", "dist", "src/metadata.ts"]
}
