PORT=8000 # API listen port

DATABASE_URL="postgresql://user:password@localhost:5432/mydb?schema=public" # Prisma PostgreSQL connection string

# JWT Configuration
JWT_ACCESS_SECRET="change-me-to-something-secure"
JWT_ACCESS_EXPIRES_IN="15m"

JWT_REFRESH_SECRET="change-me-to-something-secure-refresh"
JWT_REFRESH_EXPIRES_IN="7d"

# S3 Configuration
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_USE_SSL=false

# Mail — local dev: SMTP to Mailhog (docker-compose.dev.yml). Do not set RESEND_API_KEY locally.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=noreply@playr.com

# Production (Railway): set RESEND_API_KEY + MAIL_FROM from a verified Resend domain. MAIL_HOST not required.
# RESEND_API_KEY=re_...