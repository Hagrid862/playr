PORT=8000 # API listen port

DATABASE_URL="postgresql://user:password@localhost:5432/mydb?schema=public" # Prisma PostgreSQL connection string

# JWT Configuration
JWT_ACCESS_SECRET="change-me-to-something-secure"
JWT_ACCESS_EXPIRES_IN="15m"

JWT_REFRESH_SECRET="change-me-to-something-secure-refresh"
JWT_REFRESH_EXPIRES_IN="7d"