    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.2",
    "@golevelup/ts-vitest": "^2.2.0",
    "@nestjs/cli": "^11.0.18",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@repo/configs": "workspace:*",
