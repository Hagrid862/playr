{
  "name": "@repo/api",
  "version": "0.0.1",
  "private": true,
  "description": "",
  "license": "UNLICENSED",
  "author": "",
  "type": "module",
  "scripts": {
    "build": "tsup",
    "check-types": "tsc --noEmit",
    "dev": "concurrently -n \"BUILD,TYPE\" -c \"cyan,magenta\" \"tsup --watch --clean --onSuccess 'node --enable-source-maps dist/main.js'\" \"tsc --noEmit --watch\"",
    "debug": "concurrently -n \"BUILD,TYPE\" -c \"cyan,magenta\" \"tsup --watch --clean --onSuccess 'node --inspect-brk --inspect --enable-source-maps --log-heap-usage dist/main.js'\" \"tsc --noEmit --watch\"",
    "lint": "eslint \"{src,integration}/**/*.ts\" --fix",
    "prod": "node dist/main.js",
    "start": "node dist/main.js",
    "test:coverage": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --inspect --logHeapUsage --threads=false",
    "test:integration": "vitest run --config ./integration/vitest.config.ts",
    "test:unit": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.987.0",
    "@aws-sdk/s3-request-presigner": "^3.987.0",
