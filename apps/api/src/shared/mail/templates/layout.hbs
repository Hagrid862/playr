<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{HtmlTitle}}</title>
</head>
<body style="margin: 0; padding: 0; font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
    <table width="100%" border="0" cellpadding="0" cellspacing="0" style="background-color: #f8fafc; padding: 40px 20px;">
        <tr>
            <td align="center">
                <table width="100%" style="max-width: 520px; border-radius: 16px; border-spacing: 0; padding: 0; background-color: #ffffff; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -2px rgba(0, 0, 0, 0.1);">
                    <tr>
                        <td style="padding: 0;">
                            {{> header}}
                        </td>
                    </tr>
                    <tr>
                        <td style="padding: 0 32px 32px 32px; color: #1e293b;">
                            {{{ body }}}
                        </td>
                    </tr>
                    <tr>
                        <td style="padding: 0;">
                            {{> footer}}
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>