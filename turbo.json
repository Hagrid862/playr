{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "PORT",
    "DATABASE_URL",
    "VITE_API_URL",
    "VITE_WEB_URL",
    "VITE_ARTIST_URL",
    "VITE_ADMIN_URL",
    "CI",
    "API_PREFIX",
    "NODE_ENV"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "dev:host": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test:unit": {
      "dependsOn": ["^test:unit"]
    },
    "test:integration": {
      "dependsOn": ["^test:integration"]
    },
    "test:e2e": {
      "dependsOn": ["^test:e2e"]
    },
    "test:coverage": {
      "dependsOn": ["^test:coverage"]
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "prisma:generate": {
      "cache": true
    },
    "prisma:migrate": {
      "cache": false
    },
    "prisma:push": {
      "cache": false
    },
    "prisma:studio": {
      "cache": false,
      "persistent": true
    },
    "check-types": {
      "dependsOn": ["^build", "^check-types"]
    },
    "start": {
      "dependsOn": ["build", "^build"],
      "persistent": true
    }
  }
}
